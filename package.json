{
  "name": "montgomery",
  "version": "0.3.1",
  "description": "Fast implementation of multi-scalar multiplication in WebAssembly",
  "main": "./build/src/index.js",
  "type": "module",
  "types": "./build/src/index.d.ts",
  "exports": {
    "types": "./build/src/index.d.ts",
    "default": "./build/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitschabaude/montgomery"
  },
  "files": [
    "src",
    "build",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "watch": "tsc -w",
    "build": "tsc",
    "start": "node scripts/run-msm-pallas.ts",
    "start-web": "npm run build && ./run-in-browser scripts/run-msm-pallas.ts",
    "evaluate": "node scripts/run-msm-pallas.ts 16 16 --evaluate",
    "test": "node --test 'src/**/*.test.ts'",
    "test-msm": "node --test src/msm.test.ts",
    "benchmark": "node scripts/field-benchmarks/pallas.ts",
    "benchmark-377": "node scripts/field-benchmarks/377.ts",
    "benchmark-381": "node scripts/field-benchmarks/381.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf build"
  },
  "keywords": [],
  "author": "Gregor Mitscha-Baude",
  "license": "Apache-2.0",
  "dependencies": {
    "wasmati": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.20.1",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wabt": "^1.0.29"
  }
}
