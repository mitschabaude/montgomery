#!/usr/bin/env node
import { serveWeb } from "./scripts/build/serve-web.ts";

// first arg is the entry script; `--minify` optional flag builds the same
// bundle the published package ships, so we can reproduce minifier-related
// issues locally without repacking
let args = process.argv.slice(2).filter((a) => a !== "--minify");
let minify = process.argv.includes("--minify");

let { filePath, url } = await serveWeb(args, { minify });
console.log(`running in the browser: ${filePath}`);
console.log(`Server is running on: ${url}`);
